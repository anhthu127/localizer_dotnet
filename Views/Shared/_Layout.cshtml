<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Localizer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var routeId = ViewContext.RouteData.Values["id"]?.ToString();
    string Active(string c, string? a = null) => controller == c && (a == null || action == a) ? "active" : "";
}

<body>
    <div class="lz-shell">
        <aside class="lz-sidebar" id="lzSidebar">
            <a class="lz-brand" asp-controller="Home" asp-action="Index">
                <span class="lz-brand-mark"><i class="bi bi-translate"></i></span>
                <span>Localizer</span>
            </a>

            <nav class="lz-nav">
                <div class="lz-nav-label">Workspace</div>
                <a class="lz-nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i
                    class="bi bi-grid-1x2"></i> Dashboard</a>
                    <a class="lz-nav-link @(controller == "Applications" && action == "Index" ? "active" : "")"
                       asp-controller="Applications" asp-action="Index">
                        <i class="bi bi-app-indicator"></i> Applications
                    </a>
                    <a class="lz-nav-link @Active("Languages")" asp-controller="Languages" asp-action="Index"><i
                        class="bi bi-globe2"></i> Languages</a>
                        <a class="lz-nav-link @Active("Search")" asp-controller="Search" asp-action="Index"><i
                            class="bi bi-search"></i> Search</a>
                            @* <a class="lz-nav-link @Active("Activity")" asp-controller="Activity" asp-action="Index"><i class="bi bi-clock-history"></i> Activity</a> *@

                            @* <div class="lz-nav-label">Translations</div>
            <a class="lz-nav-link @(controller == "Keys" && action != "Upload" ? "active" : "")" asp-controller="Keys" asp-action="Create"><i class="bi bi-plus-square"></i> Add new key</a>
            <a class="lz-nav-link @Active("Keys", "Upload")" asp-controller="Keys" asp-action="Upload"><i class="bi bi-cloud-arrow-up"></i> Upload JSON</a> *@

                            <div class="lz-nav-label">Administration</div>
                            <a class="lz-nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><i
                                class="bi bi-people"></i> Users &amp; roles</a>

                                <div class="lz-nav-label">Applications</div>
                                @foreach (var app in MockData.Apps)
                                {
                                    <a class="lz-nav-link lz-nav-app @(controller == "Applications" && action == "Details" && routeId == app.Id.ToString() ? "active" : "") @(app.IsLocked ? "is-locked" : "")"
                                       data-lock-scope="@app.Id" asp-controller="Applications" asp-action="Details" asp-route-id="@app.Id">
                                        <span class="lz-dot" style="background:@app.Color"></span> @app.Name
                                        <i class="bi bi-lock-fill lz-lock-icon ms-auto" title="Locked"></i>
                                    </a>
                                }
                            </nav>
                        </aside>
                        <div class="lz-backdrop" data-sidebar-close></div>

                        <div class="lz-main">
                            <header class="lz-topbar">
                                <button class="btn lz-icon-btn d-lg-none" type="button" data-sidebar-toggle aria-label="Open menu"><i
                                    class="bi bi-list"></i></button>
                                    <form class="lz-topsearch" asp-controller="Search" asp-action="Index" method="get" role="search">
                                        <i class="bi bi-search"></i>
                                        <input name="q" type="search" placeholder="Search keys or text across all apps…" aria-label="Search"
                                               value="@(controller == "Search" ? Context.Request.Query["q"].ToString() : "")" />
                                        <kbd>/</kbd>
                                    </form>
                                    <div class="lz-topbar-actions">
                                        <a class="btn btn-primary btn-sm d-none d-md-inline-flex" asp-controller="Keys"
                                           asp-action="Create"><i class="bi bi-plus-lg"></i> New key</a>
                                        @* <button class="btn lz-icon-btn position-relative" type="button" aria-label="Notifications"> *@
                                        @*     <i class="bi bi-bell"></i><span class="lz-badge-dot"></span> *@
                                        @* </button> *@
                                        <div class="dropdown">
                                            <button class="lz-user" data-bs-toggle="dropdown" type="button">
                                                <span class="lz-avatar">LL</span>
                                                <span class="d-none d-sm-block text-start">
                                                    <span class="lz-user-name">Logan Le</span>
                                                    <span class="lz-user-role">Developer</span>
                                                </span>
                                                <i class="bi bi-chevron-down small text-muted"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Profile</a></li>
                                                <li><a class="dropdown-item" href="#"><i class="bi bi-key me-2"></i>API tokens</a></li>
                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>
                                                <li><a class="dropdown-item" href="#"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </header>

                                <main class="lz-content" role="main">
                                    @RenderBody()
                                </main>
                            </div>
                        </div>

                        <div class="toast-container position-fixed bottom-0 end-0 p-3">
                            <div id="lzToast" class="toast lz-toast" role="status" aria-live="polite" aria-atomic="true">
                                <div class="d-flex align-items-center gap-2 p-3">
                                    <i class="bi bi-check-circle-fill lz-toast-icon"></i>
                                    <div class="lz-toast-body flex-grow-1"></div>
                                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                                </div>
                            </div>
                        </div>

                        <script src="~/lib/jquery/dist/jquery.min.js"></script>
                        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                        <script src="~/js/site.js" asp-append-version="true"></script>
                        @await RenderSectionAsync("Scripts", required: false)
                    </body>

                </html>
